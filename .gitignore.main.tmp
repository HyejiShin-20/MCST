# =========================================================
# Gyeol - Root .gitignore  (E:\web 전체에 적용)
# =========================================================
# 주의: backend/.gitignore 는 backend/ 하위에만 적용된다.
# 루트(app/, data/, logs/, scripts/ 등)의 런타임/시크릿 산출물은
# 이 파일에서 무시한다.

# =========================================================
# 환경변수 / 시크릿  (절대 커밋 금지)
# =========================================================
.env
.env.*
*.env
.envrc
# 예시 파일은 추적
!.env.example
!.env.sample

# 클라우드 자격증명 (절대 커밋 금지)
credentials/
*.service-account.json
google-credentials*.json
gcp-credentials*.json
*-service-account*.json

# =========================================================
# Python - 바이트코드 / 가상환경
# =========================================================
__pycache__/
*.py[codz]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# =========================================================
# 테스트 / 정적분석 캐시
# =========================================================
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/
.cache

# =========================================================
# 런타임 데이터 / 생성 산출물  (data/)
# =========================================================
# SQLite 앱 DB (런타임 생성)
data/app.sqlite3
data/*.sqlite3
*.sqlite3
*.sqlite
db.sqlite3
db.sqlite3-journal

# 벡터 스토어 (재생성 가능, 바이너리)
data/chroma/

# 임시 미디어 (OCR/STT 작업 산출물)
data/tmp_media/
data/tmp/

# 평가/품질 리포트, 서버 로그 등 스크립트 생성물
data/exports/

# 추적 유지: 평가 케이스 / 샘플 콘텐츠는 코드의 일부 (필요 시 주석 해제)
# !data/evaluation/
# !data/samples/

# 가사/원천 대용량 데이터
data/music/lyrics/
data/raw/music/
*.lyrics.csv
*.raw_lyrics.csv
# data/raw/  # 전체를 빼려면 주석 해제

# =========================================================
# 로그 / PID / 프로세스 산출물
# =========================================================
*.log
logs/
*.pid

# 에이전트/도구가 만든 로컬 실행 산출물 (codex 등)
.codex_*
*.out.log
*.err.log

# =========================================================
# Celery / 브로커
# =========================================================
celerybeat-schedule
celerybeat.pid
*.rdb
*.aof

# =========================================================
# 백업 / 임시 파일
# =========================================================
*.bak
*.old
*.tmp
*.swp
*.swo
*~

# =========================================================
# 프런트엔드 (있을 경우)
# =========================================================
node_modules/
.next/
.nuxt/
.cache/
dist-ssr/

# =========================================================
# IDE / OS 메타파일
# =========================================================
.idea/
.vscode/
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
