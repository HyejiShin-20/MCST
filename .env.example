APP_DB_PATH=data/app.sqlite3
SAMPLE_CONTENT_PATH=data/samples/content_items.json
HF_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
HF_EMOTION_MODEL=
HF_LOCAL_FILES_ONLY=true
EMBEDDING_PROVIDER=local
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
DEFAULT_CONTENT_TYPES=music,book
HIDE_SAMPLE_CONTENT_IN_DEMO=true
DEFAULT_USER_ID=1
DEFAULT_PER_TYPE=4
MAX_PER_TYPE=4
CURRENT_TAG_VERSION=v1_keyword_prototype_balanced_emotion
MIN_RECOMMEND_CONFIDENCE=0.55
LOW_CONFIDENCE_THRESHOLD=0.45
HIGH_CONFIDENCE_THRESHOLD=0.75
EXPORT_DIR=data/exports
CHROMA_DIR=data/chroma
CHROMA_COLLECTION=culture_contents
RETRIEVAL_BACKEND=chroma
CHROMA_TOP_K=80

# Multimodal input / temporary files
MEDIA_TMP_DIR=data/tmp_media
MEDIA_MAX_UPLOAD_MB=25
MEDIA_DELETE_UPLOADS=true
TRANSCRIPTION_REVIEW_REQUIRED=true

# OCR provider
OCR_PROVIDER=google
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_VISION_FEATURE=DOCUMENT_TEXT_DETECTION
GOOGLE_VISION_LANGUAGE_HINTS=ko,en

# STT provider
STT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_TRANSCRIPTION_LANGUAGE=ko

# OpenAI emotion analysis model
OPENAI_ANALYSIS_ENABLED=true
OPENAI_EMOTION_MODEL=gpt-5.4-mini
OPENAI_EMOTION_FALLBACK_MODEL=gpt-5.4-nano
OPENAI_EMOTION_USE_WHEN=always

# OpenAI image captioning
OPENAI_VISION_MODEL=gpt-5.4-mini
OPENAI_VISION_DETAIL=high
OPENAI_IMAGE_CAPTION_ENABLED=true

# Link input extraction
LINK_TIMEOUT_SECONDS=10
LINK_MAX_BYTES=2097152
LINK_MAX_TEXT_CHARS=6000
